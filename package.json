{
  "name": "vatra",
  "version": "0.2.0",
  "private": true,
  "description": "Vatra — parallel interactive Claude Code agents in git worktrees, with a local web dashboard",
  "type": "module",
  "license": "MIT",
  "author": "Andrii Korniienko",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "vatra": "dist/server/cli.js"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch server/cli.ts start --dev",
    "dev:web": "vite",
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "start": "node dist/server/cli.js start",
    "doctor": "node dist/server/cli.js doctor",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/fix-node-pty.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.3.1",
    "better-sqlite3": "^12.4.1",
    "chokidar": "^4.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.6.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.2.0",
    "diff2html": "^3.4.52",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "ws": "^8.22.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "node-pty",
      "esbuild"
    ]
  }
}
